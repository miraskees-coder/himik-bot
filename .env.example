# Осы айнымалыларды Vercel → Project → Settings → Environment Variables бөліміне қосыңыз
TELEGRAM_BOT_TOKEN=123456789:ABCdef...
GEMINI_API_KEY=AIza...
# Кез келген ұзын кездейсоқ жол (тек A-Z, a-z, 0-9, _ және -)
TELEGRAM_SECRET_TOKEN=my_super_secret_123
# Міндетті емес, әдепкі: gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash
