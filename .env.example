# Осы айнымалыларды Vercel → Project → Settings → Environment Variables бөліміне қосыңыз
TELEGRAM_BOT_TOKEN=123456789:ABCdef...
GEMINI_API_KEY=AIza...
# Кез келген ұзын кездейсоқ жол (тек A-Z, a-z, 0-9, _ және -)
TELEGRAM_SECRET_TOKEN=my_super_secret_123
# Міндетті емес, әдепкі: gemini-flash-lite-latest
GEMINI_MODEL=gemini-flash-lite-latest
# Claude (Anthropic) кілті — қойылса, бот Claude арқылы жауап береді, әйтпесе Gemini
ANTHROPIC_API_KEY=sk-ant-...
# Міндетті емес, әдепкі: claude-opus-5-5
CLAUDE_MODEL=claude-opus-5-5
